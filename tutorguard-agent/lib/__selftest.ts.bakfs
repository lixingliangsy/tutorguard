// TutorGuard deep-data moat — deterministic self-test (run with tsx, no LLM).
// Verifies: (1) index loads all curated datasets, (2) retrieve semantic hits
// per framework, (3) guardrail G1/G5 rejection, (4) flywheel accept →
// re-index → retrieve-hit, then cleans up test storage.

import fs from 'fs'
import path from 'path'
import { retrieve, loadGovernanceIndex, invalidateGovernanceCache } from './governance-data/index'
import { applyGuardrails } from './guardrails'
import { writeback, setStatus, loadContributed, getAcceptedContributed, type ContributedSignal } from './data-flywheel'

let pass = 0
let fail = 0
function assert(name: string, cond: boolean, extra = ''): void {
  if (cond) {
    pass++
    console.log(`  ✅ ${name}`)
  } else {
    fail++
    console.log(`  ❌ ${name} ${extra}`)
  }
}

console.log('— TutorGuard deep-data moat self-test —')

// T1: index loads all six datasets (>= 50 curated entries)
const idx = loadGovernanceIndex()
assert('index loads >= 50 curated entries', idx.length >= 50, `(got ${idx.length})`)

// T2: retrieve hits COPPA verifiable-consent by "parental consent under 13"
const r1 = retrieve('verifiable parental consent under 13 ai tutor', { scope: 'coppa', topK: 3 })
assert('retrieve("parental consent under 13") → coppa-verifiable-consent present', r1.some((e) => e.id === 'coppa-verifiable-consent'), `(top: ${r1.map((e) => e.id).join(',')})`)

// T3: retrieve hits FERPA school-official exception
const r2 = retrieve('school official service provider contract ferpa education records', { scope: 'ferpa', topK: 3 })
assert('retrieve("school official contract") → ferpa-school-official present', r2.some((e) => e.id === 'ferpa-school-official'), `(top: ${r2.map((e) => e.id).join(',')})`)

// T4: retrieve hits GDPR Art.8 child-consent
const r3 = retrieve('GDPR Article 8 child consent age 16 parental authorization', { scope: 'gdpr', topK: 3 })
assert('retrieve("GDPR Art.8 child consent") → gdpr-art8-age present', r3.some((e) => e.id === 'gdpr-art8-age'), `(top: ${r3.map((e) => e.id).join(',')})`)

// T5: retrieve hits SOPIPA no-profile / UK AADC
const r4 = retrieve('SOPIPA no targeted advertising profile student data california', { scope: 'sopipa', topK: 3 })
assert('retrieve("SOPIPA no profile") → sopipa-no-profile present', r4.some((e) => e.id === 'sopipa-no-profile'), `(top: ${r4.map((e) => e.id).join(',')})`)

// T6: guardrail rejects ungrounded / absolute-assurance text (G2 + G5)
const bad = applyGuardrails('Your AI tutor is fully compliant and we guarantee it is safe for children under COPPA.', [])
assert('guardrail rejects "guarantee safe / compliant" (G2+G5)', !bad.ok && (bad.violations.includes('G5_YOU_ARE_COMPLIANT') || bad.violations.includes('G2_GUARANTEE_SAFE') || bad.violations.includes('G5_ENSURE_COMPLIANCE')), `(violations: ${bad.violations.join(',')})`)

// T7: guardrail accepts grounded decision-support text
const good = applyGuardrails('Under COPPA (16 CFR Part 312) an AI tutor for under-13s needs verifiable parental consent; below the GDPR Art.8 threshold parental authorization is required. Verify against primary law before action.', [
  { id: 'coppa-verifiable-consent', ref: 'https://www.ftc.gov/legal-library/browse/rules/childrens-online-privacy-protection-rule-coppa', title: 'Verifiable parental consent required', text: '', source: 'COPPA (FTC)', scope: 'coppa', verify: true },
])
assert('guardrail accepts grounded text', good.ok, `(violations: ${good.violations.join(',')})`)

// T8: flywheel accept → becomes retrievable, then clean up
const testId = 'selftest_' + Date.now()
const sig: ContributedSignal = {
  id: testId,
  runId: 'selftest',
  kind: 'feedback',
  scope: 'frameworks',
  rating: 5,
  status: 'pending_review',
  createdAt: new Date().toISOString(),
  verify: true,
  note: 'SELFTEST contributed entry (safe to delete)',
}
writeback([sig])
assert('flywheel writeback persisted (pending_review)', loadContributed('pending_review').some((s) => s.id === testId))
assert('contributed NOT retrievable while pending', getAcceptedContributed().every((c) => c.id !== testId))

setStatus(testId, 'accepted')
invalidateGovernanceCache()
const r5 = retrieve('selftest contributed', { topK: 10 })
assert('accepted contributed becomes retrievable', r5.some((e) => e.id === testId))

// cleanup: remove test entry. NOTE: this sandbox intercepts fs.unlinkSync
// (safe-delete shim); truncate to empty file instead of deleting the log.
setStatus(testId, 'rejected')
const remaining = loadContributed().filter((s) => s.id !== testId)
const logPath = path.join(__dirname, 'governance-data', 'contributed', 'feedback-log.jsonl')
fs.writeFileSync(logPath, remaining.map((s) => JSON.stringify(s)).join('\n') + (remaining.length ? '\n' : ''))
invalidateGovernanceCache()
assert('contributed store empty after cleanup', getAcceptedContributed().every((c) => c.id !== testId))

console.log(`\nRESULT: ${pass} passed, ${fail} failed`)
if (fail > 0) process.exit(1)
console.log('ALL GREEN ✅')
